<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:background="@color/calc_background">

    <!-- Display card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.05"
        android:layout_marginBottom="16dp"
        android:background="@drawable/calc_display_bg"
        android:elevation="10dp"
        android:gravity="end|bottom"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/calculatorHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minHeight="26dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="@color/calc_history_text"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/calculatorDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="end"
            android:maxLines="1"
            android:text="0"
            android:textColor="@color/calc_display_text"
            android:textSize="56sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- Buttons Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.15"
        android:columnCount="4"
        android:rowCount="6"
        android:clipToPadding="false"
        android:clipChildren="false">

        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnClear" style="@style/CalculatorButton.Utility" android:text="AC" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnToggleSign" style="@style/CalculatorButton.Utility" android:text="±" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPercent" style="@style/CalculatorButton.Utility" android:text="%" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnDivide" style="@style/CalculatorButton.Operation" android:text="÷" />

        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn7" style="@style/CalculatorButton.Number" android:text="7" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn8" style="@style/CalculatorButton.Number" android:text="8" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn9" style="@style/CalculatorButton.Number" android:text="9" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnMultiply" style="@style/CalculatorButton.Operation" android:text="×" />

        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn4" style="@style/CalculatorButton.Number" android:text="4" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn5" style="@style/CalculatorButton.Number" android:text="5" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn6" style="@style/CalculatorButton.Number" android:text="6" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnMinus" style="@style/CalculatorButton.Operation" android:text="−" />

        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn1" style="@style/CalculatorButton.Number" android:text="1" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn2" style="@style/CalculatorButton.Number" android:text="2" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn3" style="@style/CalculatorButton.Number" android:text="3" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnPlus" style="@style/CalculatorButton.Operation" android:text="+" />

        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn0" style="@style/CalculatorButton.Number"
            android:text="0"
            android:layout_rowSpan="2"
            android:layout_rowWeight="0.8"
            android:layout_gravity="fill" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnBackspace" style="@style/CalculatorButton.Utility"
            android:text="⌫"
            android:layout_rowSpan="2"
            android:layout_rowWeight="0.8"
            android:layout_gravity="fill" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnDot" style="@style/CalculatorButton.Utility"
            android:text="."
            android:textSize="28sp"
            android:layout_rowSpan="2"
            android:layout_rowWeight="0.8"
            android:layout_gravity="fill" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnEquals" style="@style/CalculatorButton.Accent"
            android:text="="
            android:layout_rowSpan="2"
            android:layout_rowWeight="0.8"
            android:layout_gravity="fill" />

    </GridLayout>

</LinearLayout>
