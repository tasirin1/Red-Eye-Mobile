<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.ParentalMonitor" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>

    <!-- Calculator Button Styles -->
    <style name="CalculatorButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:background">@drawable/calc_btn_function</item>
        <item name="android:elevation">3dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="CalculatorButton.Number">
        <item name="android:background">@drawable/calc_btn_number</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="CalculatorButton.Function">
    </style>

    <style name="CalculatorButton.Accent">
        <item name="android:background">@drawable/calc_btn_accent</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="CalculatorButton.Equals">
        <item name="android:background">@drawable/calc_btn_accent</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">34sp</item>
    </style>
</resources>

