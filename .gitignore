# Gradle files
.gradle/
build/
gradle-wrapper.jar

# Local configuration file (SDK path, etc)
local.properties

# Android Studio
.idea/
*.iml
.DS_Store
.externalNativeBuild
.cxx

# Generated files
*.apk
*.aab
*.ap_
*.dex
*.class
__pycache__/
*.pyc

# Keystore files (IMPORTANT: Keep secure!)
*.keystore
*.jks
release-key.keystore

# Configuration files with sensitive data
.builder_config

# Output directory
output/
apks/

# Logs
*.log
crash_log.txt
logcat.txt

# Kotlin and Java
*.jar
*.war
*.ear
bin/
gen/

# Backup files
*.bak
*~
*.swp
*.swo

# OS files
Thumbs.db

# Lint
lint-results.html
lint-results.xml
*.p12
release.p12

# Artefak uji perangkat (issue #874): rekaman/tangkapan/db/heap
# dari pengujian jangan terangkat git add -A — termasuk cadangan
# .redeyebak yang berisi kredensial terenkripsi dan media yang
# bisa memuat data anak.
*.mp4
*.m4a
*.hprof
*.redeyebak
*.db
*.zip
/*.png
screenshot_*.png
screenshot_*.jpg
camera_*.jpg

