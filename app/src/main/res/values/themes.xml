<resources>
    <!-- Base application theme. -->
    <style name="Theme.ParentalMonitor" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/calc_btn_function</item>
        <item name="colorPrimaryVariant">@color/calc_btn_function_dark</item>
        <item name="colorOnPrimary">@color/calc_btn_text</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/calc_accent</item>
        <item name="colorSecondaryVariant">@color/calc_accent_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/calc_display_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <!-- Calculator Button Styles -->
    <style name="CalculatorButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/calc_btn_text</item>
        <item name="android:background">@drawable/calc_btn_number</item>
        <item name="backgroundTint">@null</item>
        <item name="android:elevation">4dp</item>
        <item name="android:outlineProvider">background</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="CalculatorButton.Number">
        <item name="android:background">@drawable/calc_btn_number</item>
        <item name="android:textColor">@color/calc_btn_text</item>
    </style>

    <style name="CalculatorButton.Utility">
        <item name="android:background">@drawable/calc_btn_function</item>
        <item name="android:textColor">@color/calc_btn_text</item>
        <item name="android:textSize">21sp</item>
    </style>

    <style name="CalculatorButton.Operation">
        <item name="android:background">@drawable/calc_btn_function</item>
        <item name="android:textColor">@color/calc_btn_text</item>
        <item name="android:textSize">29sp</item>
        <item name="android:elevation">6dp</item>
        <item name="android:layout_columnWeight">1.12</item>
    </style>

    <style name="CalculatorButton.Accent">
        <item name="android:background">@drawable/calc_btn_accent</item>
        <item name="android:textColor">@color/calc_accent_text</item>
        <item name="android:textSize">36sp</item>
        <item name="android:elevation">8dp</item>
        <item name="android:layout_columnWeight">1.12</item>
    </style>

</resources>
