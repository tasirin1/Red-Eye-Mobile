<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#101014">

    <!-- Display card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="20dp"
        android:background="@drawable/calc_display_bg"
        android:elevation="6dp"
        android:gravity="end|bottom"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/calculatorHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:minHeight="28dp"
            android:text=""
            android:textColor="#8E8E96"
            android:textSize="18sp"
            android:fontFamily="sans-serif-light"
            android:singleLine="true" />

        <TextView
            android:id="@+id/calculatorDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="56sp"
            android:fontFamily="sans-serif-light"
            android:singleLine="true" />

    </LinearLayout>

    <!-- Buttons Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:columnCount="4"
        android:rowCount="5">

        <Button android:id="@+id/btnClear" style="@style/CalculatorButton.Function" android:text="C" android:textColor="#FF9F0A" />
        <Button android:id="@+id/btnDivide" style="@style/CalculatorButton.Function" android:text="÷" />
        <Button android:id="@+id/btnMultiply" style="@style/CalculatorButton.Function" android:text="×" />
        <Button android:id="@+id/btnMinus" style="@style/CalculatorButton.Function" android:text="−" />

        <Button android:id="@+id/btn7" style="@style/CalculatorButton.Number" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/CalculatorButton.Number" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/CalculatorButton.Number" android:text="9" />
        <Button android:id="@+id/btnPlus" style="@style/CalculatorButton.Function" android:text="+" />

        <Button android:id="@+id/btn4" style="@style/CalculatorButton.Number" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/CalculatorButton.Number" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/CalculatorButton.Number" android:text="6" />
        <Button android:id="@+id/btnEquals" style="@style/CalculatorButton.Accent"
            android:text="="
            android:layout_rowSpan="2"
            android:layout_gravity="fill_vertical" />

        <Button android:id="@+id/btn1" style="@style/CalculatorButton.Number" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/CalculatorButton.Number" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/CalculatorButton.Number" android:text="3" />

        <Button android:id="@+id/btn0" style="@style/CalculatorButton.Number"
            android:text="0"
            android:layout_columnSpan="2"
            android:layout_gravity="fill_horizontal" />
        <Button android:id="@+id/btnDot" style="@style/CalculatorButton.Number" android:text="." />

    </GridLayout>

</LinearLayout>
